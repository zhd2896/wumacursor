.game-page{background:#15242a}.game-inner{padding:23rpx 24rpx 32rpx;background:linear-gradient(180deg,#1b3034,#14242a)}.versus{display:flex;align-items:center;justify-content:space-between;padding:20rpx 17rpx;margin-bottom:21rpx}.vs{color:#f1ce8b;font-size:28rpx;font-family:Georgia,serif;margin:0 7rpx}.reserve-row{display:flex;justify-content:space-between;color:#f1d6a8;font-size:20rpx;padding:0 12rpx 14rpx}.board-area{max-width:700rpx;margin:auto}.status-area,.turn-status{margin-top:19rpx}.turn-status{min-height:76rpx;border:1rpx solid #7d694c;border-radius:15rpx;background:rgba(255,246,224,.94);display:flex;align-items:center;gap:16rpx;padding:13rpx 20rpx}.status-dot{width:13rpx;height:13rpx;background:#b44032;border-radius:50%;box-shadow:0 0 0 6rpx rgba(180,64,50,.16)}.status-title{font-size:25rpx;font-weight:700;color:#3a3128}.status-sub{font-size:19rpx;color:#807568}.think-toggle{margin-left:auto;color:#327a9b;font-size:20rpx;white-space:nowrap}.thinking-stop{text-align:center;color:#9ed9f0;font-size:20rpx;padding:11rpx}.hint-area,.settings-area{margin-top:16rpx}.settings-area{background:#fff9ee;border-radius:16rpx;padding:20rpx;font-size:22rpx;color:#706a60;line-height:1.7}.settings-title{color:#243a3a;font-weight:700;font-size:25rpx}.actions{display:flex;justify-content:space-between;gap:9rpx;margin-top:23rpx}.actions>view{flex:1;min-width:0;background:linear-gradient(150deg,#26353a,#152127);border:1rpx solid #92774e;border-radius:18rpx;color:#f5e5c7;text-align:center;padding:13rpx 0;font-size:20rpx}.actions text{display:block;font-size:35rpx;line-height:43rpx;color:#f3ca83}
.remote-info{margin:12rpx 0;padding:12rpx 18rpx;border-radius:12rpx;background:#fff5df;color:#574a38;font-size:21rpx;display:flex;align-items:center;justify-content:space-between}.remote-error{background:#ffe8e2;color:#8a322a}.remote-info button{margin:0 0 0 14rpx}
.ai-first-options{display:flex;gap:12rpx;margin-top:12rpx;flex-wrap:wrap}.ai-first-options button{flex:1;margin:0;min-width:180rpx}
.ai-difficulty-options{display:flex;gap:12rpx;margin-top:12rpx}.ai-difficulty-options button{flex:1;margin:0}
.settings-line{margin-top:8rpx;color:#666;font-size:24rpx}
.settings-active{background:#1f4b99;color:#fff}
.ai-capture-info{border-left:5rpx solid #b95242}
.analysis-status,.analysis-card{margin-top:16rpx;border-radius:14rpx;padding:18rpx 20rpx;background:#fff7e7;color:#3d3429;font-size:21rpx}
.analysis-error{background:#ffe8e2;color:#8a322a}
.analysis-title{font-size:26rpx;font-weight:700;margin-bottom:12rpx}
.analysis-subtitle{font-weight:700;margin-top:14rpx}
.analysis-line{line-height:1.7}
.review-button{margin-top:20rpx;background:#e6bd77;color:#263637;font-weight:700}
.coach-card{border:1rpx solid #d7b46c}
.coach-more{margin-top:16rpx;background:#d8ab60;color:#263637;font-weight:700}
.action-disabled{opacity:.4}
